# Copy to ~/.config/qwen38-exl3/service.env and edit before starting the unit.
# Use literal absolute paths. This file is parsed by systemd, not a shell:
# no export, ~, $HOME, references to other variables, or command substitutions.
# These are illustrative paths/settings, not a claim of a validated deployment.
QWEN_RECIPE_DIR=/absolute/path/to/Qwen3.8-Flash-Next-EXL3-DGX-Spark-recipe
RECIPE_HOME=/absolute/path/to/validated-qwen38-runtime
VENV=/absolute/path/to/validated-qwen38-runtime/venv
EXL3_SRC=/absolute/path/to/validated-qwen38-runtime/exllamav3
TABBY_DIR=/absolute/path/to/validated-qwen38-runtime/tabbyAPI
STATE_DIR=/absolute/path/to/qwen38-service-state
MODEL_DIR=/absolute/path/to/validated-model-pack

# Preserve loopback for this local service.
HOST=127.0.0.1
PORT=8899
DISABLE_AUTH=true
SERVED_NAME=Qwen3.8-Flash-Next-EXL3

# Copy the profile, PLE placement and tuning from this pack's validated run.
# This example uses one request at a time and streamed PLE.
PROFILE=single
NGRAM_RAM=false
MAX_SEQ_LEN=262144
CACHE_SIZE=262144
MAX_BATCH_SIZE=1
CHUNK_SIZE=2048

# Leave engine/server refs to the selected recipe. setup.sh --check and the
# launcher's runtime fingerprint checks must succeed with this environment.
# Add EXL3_* tuning overrides only when supported by your recorded measurements.
