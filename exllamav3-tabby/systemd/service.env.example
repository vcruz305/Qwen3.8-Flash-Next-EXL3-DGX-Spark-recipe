# Copy to ~/.config/qwen38-exl3/service.env and edit before starting the unit.
# Example account/layout from the validation host; replace paths for your account.
# These settings illustrate configuration, not a claim of a deployed winner.
# This is systemd assignment syntax, not a shell: no export, ~, $HOME, references
# to other variables or command substitutions. Use literal absolute paths.
QWEN_RECIPE_DIR=/home/cruzspark/qwen-spark-recipe
RECIPE_HOME=/home/cruzspark/qwen38-exl3-20261008
VENV=/home/cruzspark/qwen38-exl3-20261008/venv
EXL3_SRC=/home/cruzspark/qwen38-exl3-20261008/exllamav3
TABBY_DIR=/home/cruzspark/qwen38-exl3-20261008/tabbyAPI

# This is a non-symlink BASE directory. The installed invocation wrapper appends
# the fresh systemd INVOCATION_ID, then serve.sh writes that start's config/model
# view/deployment.json there. Do not put an invocation ID in this file.
STATE_DIR=/home/cruzspark/.local/state/qwen38-exl3/runs
MODEL_DIR=/home/cruzspark/models/flashnext-exl3-3.05bpw

# Preserve loopback for this local service.
HOST=127.0.0.1
PORT=8899
DISABLE_AUTH=true
SERVED_NAME=Qwen3.8-Flash-Next-EXL3

# Copy the complete settings from the pack/profile you actually validated.
# This illustrative configuration permits one request and streams the PLE table.
PROFILE=single
NGRAM_RAM=false
MAX_SEQ_LEN=262144
CACHE_SIZE=262144
MAX_BATCH_SIZE=1
CHUNK_SIZE=2048
DRAFT_MODE=mtp
DRAFT_NUM_TOKENS=5
DYNAMIC_DRAFT=true
SYSMEM_RECURRENT_CACHE=4096

# Preserve the original real ~/qwen38-exl3 directory at its canonical path.
# The unit names the dated runtime directly; an optional separate
# ~/qwen38-exl3-current alias is not required and must not move the old venv.
#
# Leave source-ref policy to the selected recipe. It pins the engine and tracks
# the Tabby fork's main during explicit setup; the service never updates either.
# Record actual tested Git commits from setup/deployment snapshots. Branch main
# is not itself a tested SHA. Normal setup.sh --check/fingerprint gates must pass.
#
# Add all measured EXL3_* controls and intentional BIGCORES, OMP_NUM_THREADS,
# MKL_NUM_THREADS, CUDA_HOME or other toolchain overrides here. Keep their values
# explicit so inherited user-manager settings cannot alter the measured profile.
